{
  "name": "concept-bracken-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "art": "echo 'Shipped plates are the lit set from redesign/project-archive (ff160b4). See docs/ASSETS.md.'",
    "screens": "node scripts/screenshots.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "qa": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=20"
  }
}
